---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EventBanner from '../components/EventBanner.astro';
import Cards from '../components/Cards.astro';
import About from '../components/About.astro';
import Rules from '../components/Rules.astro';
import Summary from '../components/Summary.astro';
import Faq from '../components/Faq.astro';
import Servers from '../components/Servers.astro';
import { site } from '../config/site';
import { useT, faqItems } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const abs = (p: string) => new URL(p, site.url).href;
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-419' : 'en',
  mainEntity: faqItems(lang).map((i) => ({
    '@type': 'Question', name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': abs('/#website'), url: abs(lang === 'pt-br' ? '/' : `/${lang}/`), name: 'SKYNET GAMING BRASIL', description: t('meta.home.description'), inLanguage: lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-419' : 'en', publisher: { '@id': abs('/#organization') } },
  faqLd,
];
---
<Base lang={lang} title={t('meta.home.title')} description={t('meta.home.description')} path="/" jsonLd={jsonLd}>
  <Hero lang={lang} />
  <Servers lang={lang} />
  <Summary lang={lang} />
  <EventBanner lang={lang} />
  <Cards lang={lang} />
  <About lang={lang} />
  <Rules lang={lang} />
  <Faq lang={lang} />
</Base>
