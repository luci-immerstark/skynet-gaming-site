---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import eventos from '../assets/img/card-eventos.jpg';
import { useT, localePath, pageRoutes } from '../i18n/utils';
import { site } from '../config/site';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang; page: 'eventos'; }
const { lang, page } = Astro.props;
const t = useT(lang);
const img = eventos;
const title = t(`${page}.title` as const);
---
<Base lang={lang} title={t(`meta.${page}.title` as const)} description={t(`meta.${page}.description` as const)} path={pageRoutes[page][lang]} paths={pageRoutes[page]} noindex={site.paginasProvisorias.includes(page)}>
  <header class="page-head">
    <Image src={img} alt="" widths={[800, 1400, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container"><h1>{title}</h1><p><span class="badge">{t('badge.soon')}</span></p></div>
  </header>
  <div class="section"><div class="container prose">
    <p>{t('lorem1')}</p><p>{t('lorem2')}</p><p>{t('lorem3')}</p>
    <p><a href={localePath(lang)}>{t('page.back')}</a></p>
  </div></div>
</Base>
