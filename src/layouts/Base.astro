---
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ogImg from '../assets/img/og-banner.jpg';
import favImg from '../assets/img/logo-robo.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../config/site';
import { type Lang } from '../i18n/ui';
import { localePath, htmlLang } from '../i18n/utils';

// altPaths: caminho de cada idioma quando difere de `path` (null = sem tradução; o seletor vai para `fallback`).
interface Props { lang: Lang; title: string; description: string; path: string; missing?: Lang[]; fallback?: string; jsonLd?: Record<string, unknown>[]; noindex?: boolean; }
const { lang, title, description, path, missing = [], fallback = '/', jsonLd = [], noindex = false } = Astro.props;
const og = await getImage({ src: ogImg, width: 1200, format: 'jpg' });
const fav32 = await getImage({ src: favImg, width: 32, height: 32, format: 'png' });
const fav180 = await getImage({ src: favImg, width: 180, height: 180, format: 'png' });
const logo512 = await getImage({ src: favImg, width: 512, height: 512, format: 'png' });
const abs = (p: string) => new URL(p, site.url).href;
const alt = Object.fromEntries((['pt-br', 'es', 'en'] as Lang[]).map((l) => [l, localePath(l, missing.includes(l) ? fallback : path)])) as Record<Lang, string>;
const has = (l: Lang) => !missing.includes(l);
const canonical = abs(alt[lang]);
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': abs('/#organization'),
  name: 'SKYNET GAMING BRASIL', alternateName: site.name, url: site.url, logo: abs(logo512.src),
  sameAs: [site.discordUrl, site.steamGroupUrl],
};
// Evento em destaque: gerado de site.event, então atualiza sozinho no próximo evento.
const ev = site.event;
const eventLd = ev.enabled && path === '/' ? {
  '@context': 'https://schema.org', '@type': 'Event', name: ev.text[lang].title, description: ev.text[lang].prize,
  startDate: ev.start, endDate: ev.end, inLanguage: htmlLang(lang),
  eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: { '@type': 'VirtualLocation', url: site.url }, image: [abs(og.src)], url: canonical,
  organizer: { '@id': abs('/#organization') },
} : null;
const graph = [organization, ...(eventLd ? [eventLd] : []), ...jsonLd];
---
<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f12" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && has('pt-br') && <link rel="alternate" hreflang="pt-BR" href={abs(alt['pt-br'])} />}
    {!noindex && has('es') && <link rel="alternate" hreflang="es-419" href={abs(alt.es)} />}
    {!noindex && has('en') && <link rel="alternate" hreflang="en" href={abs(alt.en)} />}
    {!noindex && has('pt-br') && <link rel="alternate" hreflang="x-default" href={abs(alt['pt-br'])} />}
    <link rel="icon" type="image/png" sizes="32x32" href={fav32.src} />
    <link rel="apple-touch-icon" href={fav180.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:locale" content={{ 'pt-br': 'pt_BR', es: 'es_LA', en: 'en_US' }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(og.src)} />
    <script is:inline src="/lang.js"></script>
    {graph.map((d) => <JsonLd data={d} />)}
    {site.analyticsToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}></script>}
  </head>
  <body>
    <a class="skip" href="#main">{{ 'pt-br': 'Pular para o conteúdo', es: 'Saltar al contenido', en: 'Skip to content' }[lang]}</a>
    <Header lang={lang} alt={alt} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script>
      document.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((a) =>
        a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang || 'pt-br'); } catch {} }));
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        const label = btn.querySelector('.copy-label');
        const orig = label?.textContent ?? '';
        btn.addEventListener('click', async () => {
          const text = 'connect ' + btn.dataset.copy;
          try { await navigator.clipboard.writeText(text); } catch { /* sem permissão: ignora */ }
          if (label) { label.textContent = btn.dataset.done ?? ''; setTimeout(() => (label.textContent = orig), 2000); }
        });
      });
    </script>
  </body>
</html>
