---
import logo from '../assets/img/logo-grande-nome-branco.svg';
import { site, serverList } from '../config/site';
import { useT, formatLong } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
// Data gerada no build (fuso de Brasília), formatada conforme o idioma.
const built = new Date();
const builtIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(built);
const links = [
  { href: site.discordUrl, label: t('link.discord') },
  { href: site.steamGroupUrl, label: t('link.steam') },
  { href: site.rankingUrl, label: t('link.ranking') },
  { href: site.sourcebansUrl, label: t('link.sourcebans') },
];
---
<footer class="footer">
  <div class="container inner">
    <img class="mark" src={logo.src} alt="Logo SKYNET GAMING" width="64" height="64" loading="lazy" decoding="async" />
    <p class="name">SKYNET GAMING TF2</p>
    <nav aria-label={t('footer.links')}>
      <ul>{links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}<span class="sr"> ({t('external')})</span></a></li>)}</ul>
    </nav>
    <p class="ips">{serverList.map((s, i) => <>{i > 0 && ' · '}{s.id === 'classic' ? 'Classic Maps' : 'Dodgeball'}: <code>{s.ip}</code></>)}</p>
    <p class="copy">{t('footer.rights')}</p>
    <p class="valve">{t('footer.valve')}</p>
    <p class="upd"><time datetime={builtIso}>{t('footer.updated').replace('{date}', formatLong(built, lang))}</time></p>
  </div>
</footer>
<style>
  .footer { background: var(--surface); border-top: 1px solid rgba(255,215,0,.15); padding: 3rem 0; text-align: center; }
  .inner { display: flex; flex-direction: column; align-items: center; gap: .8rem; }
  .mark { opacity: .7; }
  .name { font-family: var(--font-display); font-weight: 700; letter-spacing: .12em; font-size: 1.3rem; margin: 0; }
  ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1.5rem; padding: 0; margin: .5rem 0; }
  a { color: var(--text); text-decoration: none; } a:hover { color: var(--gold); text-decoration: underline; }
  .ips { margin: 0; color: var(--muted); font-size: .9rem; } .ips code { color: var(--text); }
  .copy, .valve { margin: 0; color: var(--muted); font-size: .88rem; }
  .upd { margin: 0; color: var(--muted); font-size: .8rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
