---
import { Image } from 'astro:assets';
import bg from '../assets/img/hero-bg.jpg';
import logo from '../assets/img/logo-robo.png';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { useT } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const chips = ['chips.slots', 'chips.tick', 'chips.city', 'chips.maps', 'chips.ranking'] as const;
---
<section class="hero">
  <Image class="bg" src={bg} alt="" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="container content">
    <div class="logo"><Image src={logo} alt="Logo SKYNET GAMING: robô" width={220} height={220} densities={[1, 2]} loading="eager" /></div>
    <h1>{t('hero.title')}</h1>
    <p class="tagline">{t('hero.tagline')}</p>
    <ul class="chips">{chips.map((c) => <li>{t(c)}</li>)}</ul>
    <a class="btn btn-discord" href={site.discordUrl} target="_blank" rel="noopener noreferrer">
      <Icon name="discord" size={26} />{t('btn.discord')}<span class="sr"> ({t('external')})</span>
    </a>
    <div class="secondary">
      <a class="btn btn-ghost" href={`steam://connect/${site.serverIp}`}><Icon name="play" size={18} />{t('btn.play')}</a>
      <button class="btn btn-ghost" type="button" data-copy={site.serverIp} data-done={t('btn.copied')}>
        <Icon name="copy" size={18} /><span class="copy-label" aria-live="polite">{t('btn.copy')}</span>
      </button>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; min-height: 100svh; display: grid; place-items: center; padding: 6rem 0 3rem; isolation: isolate; text-align: center; overflow: hidden; }
  .hero :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at center, rgba(13,15,18,.55), rgba(13,15,18,.88)); }
  .content { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
  .logo :global(img) { width: clamp(140px, 30vw, 220px); height: auto; border-radius: 24px; filter: drop-shadow(0 0 18px rgba(255,255,255,.35)) drop-shadow(0 0 40px rgba(120,200,255,.35)); }
  h1 { font-size: clamp(2.2rem, 7vw, 4.4rem); text-transform: uppercase; text-shadow: 0 2px 20px rgba(0,0,0,.8); }
  .tagline { font-size: clamp(1.05rem, 2.5vw, 1.4rem); margin: 0; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; padding: 0; margin: 0; }
  .chips li { background: rgba(0,0,0,.55); border: 1px solid rgba(255,215,0,.4); border-radius: 999px; padding: .3rem .9rem; font-size: .9rem; }
  .secondary { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
