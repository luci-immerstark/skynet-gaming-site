---
import { site } from '../config/site';
import { useT, formatLong } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
// Definição em uma frase, útil para leitores e para buscadores com IA.
const text = t('summary.text')
  .replace('{classicDate}', formatLong(site.servers.classic.launchDate, lang))
  .replace('{dodgeballDate}', formatLong(site.servers.dodgeball.launchDate, lang));
// Os comandos connect viram <code>; os IPs vêm de site.servers.
const parts = text.split(/(connect \{(?:classic|dodgeball|l4d2)\})/).map((p) => {
  const m = p.match(/^connect \{(classic|dodgeball|l4d2)\}$/);
  return m ? { code: `connect ${site.servers[m[1] as 'classic' | 'dodgeball' | 'l4d2'].ip}` } : { text: p };
});
---
<section class="summary" aria-label="SKYNET Gaming">
  <div class="container">
    <p>{parts.map((p) => ('code' in p ? <code>{p.code}</code> : p.text))}</p>
  </div>
</section>
<style>
  .summary { padding: 2rem 0 0; }
  p { max-width: 900px; margin: 0 auto; text-align: center; color: #d6d9de; font-size: 1.05rem; line-height: 1.7; }
  code { background: #000; padding: .15rem .45rem; border-radius: 6px; white-space: nowrap; }
</style>
