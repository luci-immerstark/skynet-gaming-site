---
interface Props { lang: 'pt-br' | 'es'; }
const { lang } = Astro.props;
---
{lang === 'pt-br' ? (
  <svg viewBox="0 0 28 20" width="28" height="20" aria-hidden="true" focusable="false">
    <rect width="28" height="20" rx="2" fill="#009c3b"/>
    <path d="M14 2.5 25 10 14 17.5 3 10z" fill="#ffdf00"/>
    <circle cx="14" cy="10" r="4.2" fill="#002776"/>
    <path d="M9.9 9.2c2.8-.6 5.6-.2 8.2 1.4" stroke="#fff" stroke-width=".8" fill="none"/>
  </svg>
) : (
  <svg viewBox="0 0 28 20" width="28" height="20" aria-hidden="true" focusable="false">
    <rect width="28" height="20" rx="2" fill="#c60b1e"/>
    <rect y="5" width="28" height="10" fill="#ffc400"/>
  </svg>
)}
