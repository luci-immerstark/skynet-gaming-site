---
import logo from '../assets/img/logo-pequeno-colorido.svg';
import Flag from './Flag.astro';
import { site } from '../config/site';
import { localePath, pagePath, useT, htmlLang } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang; alt: Record<Lang, string>; }
const { lang, alt } = Astro.props;
const t = useT(lang);
const blogHref = pagePath(lang, 'blog');
const inBlog = Astro.url.pathname.replace(/\/+$/, '').startsWith(blogHref.replace(/\/+$/, ''));
const names: Record<Lang, string> = { 'pt-br': 'Português (Brasil)', es: 'Español', en: 'English' };
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(lang)}>
      <img src={logo.src} alt="Logo SKYNET GAMING" width="36" height="36" decoding="async" />
      <span>SKYNET GAMING</span>
    </a>
    <nav class="nav" aria-label="Menu">
      <a href={blogHref} aria-current={inBlog ? 'page' : undefined}>{t('nav.blog')}</a>
      <a href={site.steamGroupUrl} target="_blank" rel="noopener">{t('nav.steam')}</a>
      <a href="https://stats.skynet-tf2.com.br/hlstats.php" target="_blank" rel="noopener">{t('nav.ranking')}</a>
      <a href="https://bans.skynet-tf2.com.br/index.php?p=home" target="_blank" rel="noopener">{t('nav.bans')}</a>
      <a href={`${localePath(lang)}#regras`}>{t('nav.rules')}</a>
    </nav>
    <div class="lang" role="group" aria-label={t('nav.lang')}>
      {(['pt-br', 'es', 'en'] as Lang[]).map((l) => (
        <a href={alt[l]} data-lang={l} hreflang={htmlLang(l)} lang={htmlLang(l)}
           aria-pressed={l === lang ? 'true' : 'false'} aria-label={names[l]} title={names[l]}>
          <Flag lang={l} />
        </a>
      ))}
    </div>
  </div>
</header>
<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgba(13,15,18,.78); backdrop-filter: blur(8px); border-bottom: 1px solid rgba(255,255,255,.06); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { display: flex; align-items: center; gap: .6rem; font-family: var(--font-display); font-weight: 700; letter-spacing: .08em; color: var(--text); text-decoration: none; }
  .brand img { display: block; }
  .nav { margin-left: auto; margin-right: 1.2rem; } .nav a { color: var(--text); text-decoration: none; font: 700 1rem var(--font-display); letter-spacing: .08em; text-transform: uppercase; padding: .3rem .2rem; } .nav a:hover, .nav a[aria-current='page'] { color: var(--gold); } .nav a + a { margin-left: 1rem; } .nav a { white-space: nowrap; }
  .lang { display: flex; gap: .5rem; }
  .lang a { display: block; line-height: 0; padding: 4px; border-radius: 6px; border: 2px solid transparent; opacity: .55; transition: opacity .2s, border-color .2s; }
  .lang a:hover { opacity: .9; }
  .lang a[aria-pressed='true'] { opacity: 1; border-color: var(--gold); }
  .brand span { white-space: nowrap; }
  @media (max-width: 1000px) { .brand span { display: none; } }
  @media (max-width: 760px) { .nav { margin-right: .6rem; min-width: 0; overflow-x: auto; white-space: nowrap; scrollbar-width: none; } .nav::-webkit-scrollbar { display: none; } .nav a { font-size: .8rem; letter-spacing: .04em; } .nav a + a { margin-left: .6rem; } .lang { gap: .15rem; } }
</style>
