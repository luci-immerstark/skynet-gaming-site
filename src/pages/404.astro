---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
---
<Base lang="pt-br" title={ui['pt-br']['meta.404.title']} description={ui['pt-br']['404.text']} path="/404">
  <section class="nf">
    <div class="container">
      <p class="code">404</p>
      {(['pt-br', 'es', 'en'] as const).map((l) => (
        <div class="msg" data-l={l} hidden={l !== 'pt-br'}>
          <h1>{ui[l]['404.title']}</h1>
          <p>{ui[l]['404.text']}</p>
          <a class="btn btn-gold" href={l === 'pt-br' ? '/' : `/${l}/`}>{ui[l]['404.home']}</a>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; place-items: center; text-align: center; padding: 6rem 0 3rem; }
  .code { font: 700 clamp(6rem, 25vw, 12rem)/1 var(--font-display); color: var(--gold); margin: 0; text-shadow: 0 0 40px rgba(255,215,0,.35); }
  h1 { font-size: clamp(1.8rem, 5vw, 3rem); margin-bottom: .8rem; }
  .msg p { margin: 0 0 1.5rem; color: var(--muted); }
</style>
<script>
  const m = location.pathname.match(/^\/(es|en)(\/|$)/);
  const cur = m ? m[1] : 'pt-br';
  document.querySelectorAll<HTMLElement>('.msg').forEach((el) => (el.hidden = el.dataset.l !== cur));
  document.documentElement.lang = cur === 'pt-br' ? 'pt-BR' : cur;
</script>
