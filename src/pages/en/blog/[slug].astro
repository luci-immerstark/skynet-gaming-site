---
import { getCollection } from 'astro:content';
import BlogPost from '../../../views/BlogPost.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.id.startsWith('en/') && !p.data.draft);
  return posts.map((post) => {
    const slug = post.id.split('/').slice(1).join('/');
    return { params: { slug }, props: { post, slug } };
  });
}
const { post, slug } = Astro.props;
---
<BlogPost lang="en" post={post} slug={slug} />
